    // Reviews: anyone can read and submit reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
>>>>>>> e85cb62a5443344a414368b3222d920cd6612f48
    }

    // ── Blog posts: anyone can read published posts, admin can manage all ─────
    match /blog/{postId} {
      allow read:  if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // ── Coupons: anyone can read, only admin can write ────────────────────────
    match /coupons/{couponId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Users: users can read/write their own profile, admins can read all ────
    // This collection stores role information (role: "admin" | "user").
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Admin Users: only admins can read this collection (via Admin SDK too) ─
    // The Admin SDK bypasses these rules, but client-side reads still need them.
    match /adminUsers/{userId} {
      allow read:  if isAdmin();
      allow write: if false; // All writes go through the Admin SDK API route only
    }
  }
}
